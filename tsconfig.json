{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@agent-runtime-map/schema": ["packages/schema/src/index.ts"],
      "@agent-runtime-map/typescript": ["adapters/typescript/src/index.ts"],
      "@agent-runtime-map/logic-compiler": ["packages/logic-compiler/src/index.ts"],
      "@agent-runtime-map/core": ["packages/core/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "adapters/**/*.ts",
    "tests/**/*.ts"
  ]
}
