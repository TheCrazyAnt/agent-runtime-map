{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "paths": {
      "@agent-runtime-map/schema": [
        "./packages/schema/src/index.ts"
      ],
      "@agent-runtime-map/analysis-kit": [
        "./packages/analysis-kit/src/index.ts"
      ],
      "@agent-runtime-map/python": [
        "./adapters/python/src/index.ts"
      ],
      "@agent-runtime-map/project-reader": [
        "./packages/project-reader/src/index.ts"
      ],
      "@agent-runtime-map/semantic": [
        "./packages/semantic/src/index.ts"
      ],
      "@agent-runtime-map/react": [
        "./packages/react/src/index.ts"
      ],
      "@agent-runtime-map/typescript": [
        "./adapters/typescript/src/index.ts"
      ],
      "@agent-runtime-map/logic-compiler": [
        "./packages/logic-compiler/src/index.ts"
      ],
      "@agent-runtime-map/core": [
        "./packages/core/src/index.ts"
      ],
      "@agent-runtime-map/mcp": [
        "./packages/mcp/src/index.ts"
      ]
    }
  },
  "include": [
    "./packages/**/*.ts",
    "./packages/**/*.tsx",
    "./adapters/**/*.ts",
    "tests/**/*.ts"
  ]
}
