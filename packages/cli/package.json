{
  "name": "agent-runtime-map",
  "version": "0.8.0",
  "description": "Inspect every Agent feature as an evidence-backed, step-through execution circuit.",
  "homepage": "https://github.com/TheCrazyAnt/agent-runtime-map#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheCrazyAnt/agent-runtime-map.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/TheCrazyAnt/agent-runtime-map/issues"
  },
  "type": "module",
  "bin": {
    "agent-runtime-map": "dist/cli.js",
    "logic-map": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-viewer.mjs",
    "prepack": "npm run build -w @agent-runtime-map/viewer && npm run build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@agent-runtime-map/core": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "codebase",
    "visualization",
    "static-analysis",
    "architecture",
    "agents",
    "agent-runtime-map",
    "logic-map",
    "agent-debugging",
    "workflow"
  ],
  "publishConfig": {
    "access": "public"
  }
}
