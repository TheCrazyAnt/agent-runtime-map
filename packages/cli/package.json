{
  "name": "logic-map",
  "version": "0.1.0",
  "description": "Turn a TypeScript or JavaScript codebase into an evidence-backed interactive logic map.",
  "homepage": "https://github.com/tangyishun9846/logic-map#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangyishun9846/logic-map.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/tangyishun9846/logic-map/issues"
  },
  "type": "module",
  "bin": {
    "logic-map": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-viewer.mjs",
    "prepack": "npm run build -w @logic-map/viewer && npm run build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@logic-map/core": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "codebase",
    "visualization",
    "static-analysis",
    "architecture",
    "agents",
    "logic-map"
  ],
  "publishConfig": {
    "access": "public"
  }
}
