{
  "name": "@agent-runtime-map/react",
  "version": "0.9.0",
  "description": "Reusable blueprint-style React Flow components for Agent Runtime Map.",
  "homepage": "https://github.com/TheCrazyAnt/agent-runtime-map/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheCrazyAnt/agent-runtime-map.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/TheCrazyAnt/agent-runtime-map/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/element.tsx --format esm --dts --external react --external react-dom --external @xyflow/react --external lucide-react && node scripts/copy-styles.mjs",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@xyflow/react": "^12.11.5",
    "lucide-react": "^1.37.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.5"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "elkjs": "^0.12.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  }
}
